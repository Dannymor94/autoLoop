{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dannymor94/autoLoop/blob/main/contracts/runner-events.json",
  "title": "autoLoop Runner Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "project_id", "task_id", "attempt_id", "request_id", "fencing_token", "event_type", "occurred_at"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["STARTED", "HEARTBEAT", "COMPLETED", "FAILED", "INTERRUPTED", "USAGE", "CHECKPOINT"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "head_sha": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "base_sha": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"}
  },
  "description": "Runner events are observations only; they never authorize canonical state changes or merges."
}
