{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dannymor94/autoLoop/blob/main/contracts/task.schema.json",
  "title": "autoLoop Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "task_id", "plan_id", "acceptance_spec_hash", "dependency_ids", "title", "initial_state"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "acceptance_spec_hash": {"$ref": "#/$defs/sha256"},
    "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "initial_state": {"const": "READY"},
    "expected_head_sha": {"anyOf": [{"$ref": "#/$defs/gitSha"}, {"type": "null"}]},
    "expected_base_sha": {"anyOf": [{"$ref": "#/$defs/gitSha"}, {"type": "null"}]},
    "protected_path_approval_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"}
  }
}
